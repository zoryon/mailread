SECRET_KEY=django-insecure-change-me-to-a-long-random-value
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3002
ADMIN_APPROVAL_EMAIL=

# Docker/PostgreSQL deployment. Use DATABASE_URL, or the POSTGRES_* variables below.
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Mailread <no-reply@mailread.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USE_SSL=True
MAIL_IMAP_USER=central-mailbox@gmail.com
MAIL_IMAP_PASSWORD=google-app-password
MAIL_IMAP_FOLDER=INBOX
MAIL_IMAP_TIMEOUT=20
MAIL_PAGE_SIZE=50
MAIL_LIST_MESSAGE_BYTES=32768
MAIL_MAX_MESSAGE_BYTES=524288
MAIL_LIST_CACHE_SECONDS=900
MAIL_MESSAGE_CACHE_SECONDS=86400
MAIL_POLL_SECONDS=30
# Optional. Empty uses backend/.mail-cache (or /app/backend/.mail-cache in Docker).
MAIL_CACHE_DIR=
MAIL_CACHE_MAX_ENTRIES=1000
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
ELEVATED_USER_APPROVAL_MINUTES=30
